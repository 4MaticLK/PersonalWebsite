# Enables persistent portfolio suggestions in production (Vercel Blob).
# Create a Blob store in the Vercel dashboard, then add this token to project env vars.
# Local dev writes to data/portfolio-suggestions.json instead.
BLOB_READ_WRITE_TOKEN=

# Lets you unlock moderation (delete topics/replies) on the portfolio suggestions panel.
# Set a long random string — enter it once in the browser under "Moderate".
PORTFOLIO_SUGGESTIONS_ADMIN_TOKEN=
