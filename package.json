{
  "name": "personal-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "rollup": "npm:@rollup/wasm-node"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:server-lib && tsc -b && vite build",
    "build:server-lib": "tsc -p packages/server-lib",
    "verify:portfolio": "npx tsx scripts/verifyPortfolio.mts",
    "audit:current-book": "npx tsx scripts/auditCurrentBook.mts",
    "sync:portfolio": "npx tsx scripts/syncPortfolioFromRobinhood.mts",
    "apply:model-portfolio": "npx tsx scripts/applyModelPortfolio.mts",
    "refresh:portfolio-prices": "npx tsx scripts/refreshPortfolioPrices.mts",
    "auto:portfolio": "npx tsx scripts/dailyPortfolioAutomation.mts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@personal-website/server-lib": "file:packages/server-lib",
    "@vercel/blob": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^2.15.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
